<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Package identity -->
		<PackageId>CoreSystem.Cache.Rehydration</PackageId>
		<Version>2.2.1</Version>

		<!-- Assembly versioning -->
		<AssemblyVersion>2.2.1.0</AssemblyVersion>
		<FileVersion>2.2.1.0</FileVersion>
		<InformationalVersion>2.2.1</InformationalVersion>

		<!-- Package metadata -->
		<Description>Cache recovery component for CoreSystem.Cache on .NET 8, .NET 9 and .NET 10 that restores tracked memory fallback entries to the primary cache provider after recovery.</Description>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Rehydration</PackageProjectUrl>
		<PackageTags>Cache;Caching;Rehydration;Recovery;Fallback;DistributedCache;.NET8;.NET9;.NET10</PackageTags>

		<!-- Release notes -->
		<PackageReleaseNotes>2.2.1: Dependency refresh, patch release because no public API changed and no code changed. This build declares CoreSystem.Cache 3.1.2, so the move to 3.1.x announced in 2.2.0 is now in effect. CoreSystem.Cache 3.1.2 carries CoreSystem.Memory 1.1.1, CoreSystem.Resilience 2.1.1 and CoreSystem.Serialization 1.3.1, which are the versions this package is built and tested against, so consumers stop resolving the older 1.1.0, 2.1.0 and 1.3.0 graph. Nothing is renamed and no behavior changed. The AddHealthChecks() prerequisite still applies: RehydrationService takes a HealthCheckService, so without it the host fails to start, and without a primary-tagged check rehydration silently never runs.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Internal visibility -->
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CoreSystem.Cache" />
	</ItemGroup>

</Project>