<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache.Rehydration</PackageId>
		<Version>2.1.3</Version>
		<AssemblyVersion>2.1.3</AssemblyVersion>
		<FileVersion>2.1.3.0</FileVersion>
		<InformationalVersion>2.1.3</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>
			Cache recovery component for CoreSystem.Cache on .NET 8 that restores
			tracked memory fallback entries to the primary cache provider after recovery.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Rehydration</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Cache;Caching;Rehydration;Recovery;Fallback;DistributedCache;.NET8
		</PackageTags>
		<PackageReleaseNotes>2.1.3: Dependency refresh. Depends on CoreSystem.Cache 3.0.2, which moves to CoreSystem.Resilience 2.0.3 and CoreSystem.Serialization 1.2.4. No API changed, nothing is renamed, and no code changed here. Correction to the notes shipped with the previous versions, which claimed this package restores on .NET SDK 10 and later: that claim is false and was never verified. Tested against a real net10.0 consumer, restore fails with NU1605 through CoreSystem.Resilience, which constrains Microsoft.Extensions.* to 8.0.x while OpenTelemetry asks for 10.0.0, and the same is true of every version of this package up to and including 2.1.2. Projects on .NET 8 are unaffected. The AddHealthChecks() prerequisite still applies: RehydrationService takes a HealthCheckService, so without it the host fails to start, and without a primary-tagged check rehydration silently never runs.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="CoreSystem.Cache" />
	</ItemGroup>

</Project>
