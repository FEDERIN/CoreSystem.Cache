<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Package identity -->
		<PackageId>CoreSystem.Cache.Rehydration</PackageId>
		<Version>2.2.0</Version>

		<!-- Assembly versioning -->
		<AssemblyVersion>2.2.0</AssemblyVersion>
		<FileVersion>2.2.0.0</FileVersion>
		<InformationalVersion>2.2.0</InformationalVersion>

		<!-- Package metadata -->
		<Description>Cache recovery component for CoreSystem.Cache on .NET 8, .NET 9 and .NET 10 that restores tracked memory fallback entries to the primary cache provider after recovery.</Description>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Rehydration</PackageProjectUrl>
		<PackageTags>Cache;Caching;Rehydration;Recovery;Fallback;DistributedCache;.NET8;.NET9;.NET10</PackageTags>

		<!-- Release notes -->
		<PackageReleaseNotes>2.2.0: Multi-targeting release. The package now ships net8.0, net9.0 and net10.0 assets instead of net8.0 only. Cross-repo dependencies are refreshed to CoreSystem.Http 1.2.0, CoreSystem.Memory 1.1.0, CoreSystem.Resilience 2.1.0 and CoreSystem.Serialization 1.3.0, which is what removes the NU1605 restore failure on net10.0 described in 2.1.3: earlier Resilience versions constrained Microsoft.Extensions.* to 8.0.x while OpenTelemetry asks for 10.0.0. Verified with real net8.0, net9.0 and net10.0 consumer projects: all three restore and resolve with no workaround. This build still declares CoreSystem.Cache 3.0.2 because that is the version on the feed while it is prepared; the pin moves to 3.1.0 once that version is published. No public API changed, nothing is renamed and no code changed. The AddHealthChecks() prerequisite still applies: RehydrationService takes a HealthCheckService, so without it the host fails to start, and without a primary-tagged check rehydration silently never runs.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Internal visibility -->
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CoreSystem.Cache" />
	</ItemGroup>

</Project>