<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache.Rehydration</PackageId>
		<Version>3.0.0</Version>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<FileVersion>3.0.0.0</FileVersion>
		<InformationalVersion>3.0.0</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>
			Cache recovery component for CoreSystem.Cache on .NET 8 that restores
			tracked memory fallback entries to the primary cache provider after recovery.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Rehydration</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Cache;Caching;Rehydration;Recovery;Fallback;DistributedCache;.NET8
		</PackageTags>
		<PackageReleaseNotes>3.0.0: Released to move the CoreSystem.Cache dependency to 3.0.0, which removes CacheOptions.MaxCacheableSize. That property was declared but never read by any code, so nothing in this package ever enforced it and no behaviour here changes. If you set MaxCacheableSize, delete the assignment; there is no replacement and no size limit is applied. No other public API is removed, renamed, or changed, and RehydrationService behaves exactly as in 2.1.1. The AddHealthChecks() prerequisite still applies: RehydrationService takes a HealthCheckService, so without it the host fails to start, and without a primary-tagged check rehydration silently never runs.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache\Core.Cache.csproj" />
	</ItemGroup>

</Project>
