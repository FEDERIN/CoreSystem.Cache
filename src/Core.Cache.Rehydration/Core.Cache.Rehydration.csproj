<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache.Rehydration</PackageId>
		<Version>2.1.1</Version>
		<AssemblyVersion>2.1.1</AssemblyVersion>
		<FileVersion>2.1.1.0</FileVersion>
		<InformationalVersion>2.1.1</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>
			Cache recovery component for CoreSystem.Cache on .NET 8 that restores
			tracked memory fallback entries to the primary cache provider after recovery.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Rehydration</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Cache;Caching;Rehydration;Recovery;Fallback;DistributedCache;.NET8
		</PackageTags>
		<PackageReleaseNotes>2.1.1: The AddHealthChecks() prerequisite is now documented. RehydrationService takes a HealthCheckService, so without it the host fails to start, and without a primary-tagged check rehydration silently never runs. The README's eight documentation links pointed at .md files that are not part of the package and were dead for every consumer; it now links the published site. The InstanceName examples no longer show a doubled colon. The registration failure semantics are documented accurately: a disabled core cache registers nothing and does not throw. Logging uses LoggerMessage delegates. XML documentation is now shipped. No public API was removed or renamed; the shipped XML documentation is the user-facing addition, which is why this is a minor release.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache\Core.Cache.csproj" />
	</ItemGroup>

</Project>
