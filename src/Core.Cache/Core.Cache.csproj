<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache</PackageId>
		<Version>2.1.1</Version>
		<AssemblyVersion>2.1.1</AssemblyVersion>
		<FileVersion>2.1.1.0</FileVersion>
		<InformationalVersion>2.1.1</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Production-ready cache abstraction for .NET 8 with In-Memory caching, extensible external storage, tag-based invalidation, HTTP response caching, and OpenTelemetry metrics.</Description>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>Cache;Caching;DistributedCache;MemoryCache;HTTP;OpenTelemetry;Observability;.NET8</PackageTags>
		<PackageReleaseNotes>2.1.1: Ships XML documentation for the whole public API, so IntelliSense now works from the package. Corrects documentation that misstated the public API: DefaultExpiration applies only to HTTP response caching and is not a fallback for SetAsync or GetOrAddAsync, AddHealthChecks() is a required prerequisite, and MaxCacheableSize is reserved and not enforced. Logging paths use LoggerMessage delegates instead of ILogger extension calls. Quality gates enabled (TreatWarningsAsErrors, EnforceCodeStyleInBuild, latest-recommended). No public API was removed or renamed: every modified type is internal, and the shipped XML documentation is the user-facing addition, which is why this is a minor release.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.Http" />
		<PackageReference Include="CoreSystem.Memory" />
		<PackageReference Include="CoreSystem.Resilience" />
		<PackageReference Include="CoreSystem.Serialization" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Redis" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration" />
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>