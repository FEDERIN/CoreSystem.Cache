<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache</PackageId>
		<Version>3.0.2</Version>
		<AssemblyVersion>3.0.2</AssemblyVersion>
		<FileVersion>3.0.2.0</FileVersion>
		<InformationalVersion>3.0.2</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Production-ready cache abstraction for .NET 8 with In-Memory caching, extensible external storage, tag-based invalidation, HTTP response caching, and OpenTelemetry metrics.</Description>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>Cache;Caching;DistributedCache;MemoryCache;HTTP;OpenTelemetry;Observability;.NET8</PackageTags>
		<PackageReleaseNotes>3.0.2: Dependency refresh. Moves to CoreSystem.Resilience 2.0.3, which carries Polly 8.8.0, OpenTelemetry 1.20.0 and CoreSystem.Observability.Abstractions 1.0.2, and to CoreSystem.Serialization 1.2.4. No API changed, nothing is renamed, and no code changed: the entire difference is in the declared dependency versions. Projects on .NET 8 are unaffected by the refresh. Correction to the 3.0.1 notes, which stated that this package restores on .NET SDK 10 and later: that claim is false and was never verified. Tested against a real net10.0 consumer, Resilience 2.0.2 and 2.0.3 both fail restore with NU1605, because Resilience constrains Microsoft.Extensions.* to 8.0.x while OpenTelemetry asks for 10.0.0. Until CoreSystem.Resilience stops constraining them, a net10.0 consumer has to pin Microsoft.Extensions.* to 10.0.x directly. The two breaking changes introduced in 3.0.0 still apply, so migrating from 2.x means deleting any assignment to CacheOptions.MaxCacheableSize, referencing IExternalCacheStorage instead of ICacheTagIndex&lt;T&gt;, and removing any direct use of MemoryKeyTracker or DefaultRequestCachePolicy.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.Http" />
		<PackageReference Include="CoreSystem.Memory" />
		<PackageReference Include="CoreSystem.Resilience" />
		<PackageReference Include="CoreSystem.Serialization" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Redis" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration" />
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>