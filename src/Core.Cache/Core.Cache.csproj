<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.Cache</PackageId>
		<Version>3.0.1</Version>
		<AssemblyVersion>3.0.1</AssemblyVersion>
		<FileVersion>3.0.1.0</FileVersion>
		<InformationalVersion>3.0.1</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Production-ready cache abstraction for .NET 8 with In-Memory caching, extensible external storage, tag-based invalidation, HTTP response caching, and OpenTelemetry metrics.</Description>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>Cache;Caching;DistributedCache;MemoryCache;HTTP;OpenTelemetry;Observability;.NET8</PackageTags>
		<PackageReleaseNotes>3.0.1: Depends on CoreSystem.Resilience 2.0.2, which fixes a transitive version conflict that made this package unrestorable on .NET SDK 10 and later. Resilience 2.0.1 pinned Microsoft.Extensions.* to 8.0.x while OpenTelemetry.Extensions.Hosting 1.19.0 asks for 10.0.0, so restore produced NU1605 and the build failed before compiling anything. 3.0.0 was affected and cannot be replaced, since published versions are immutable; use 3.0.1 instead. Projects on SDK 8 are unaffected by either version. No API changed, nothing is renamed, and no code changed: the fix is entirely in the dependency version. The two breaking changes introduced in 3.0.0 still apply, so migrating from 2.x means deleting any assignment to CacheOptions.MaxCacheableSize, referencing IExternalCacheStorage instead of ICacheTagIndex&lt;T&gt;, and removing any direct use of MemoryKeyTracker or DefaultRequestCachePolicy.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.Http" />
		<PackageReference Include="CoreSystem.Memory" />
		<PackageReference Include="CoreSystem.Resilience" />
		<PackageReference Include="CoreSystem.Serialization" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="Core.Cache.Redis" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration" />
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.Rehydration.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.UnitTests" />
		<InternalsVisibleTo Include="Core.Cache.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>