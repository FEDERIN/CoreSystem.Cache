<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Package identity -->
		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>2.2.0</Version>

		<!-- Assembly versioning -->
		<AssemblyVersion>2.2.0</AssemblyVersion>
		<FileVersion>2.2.0.0</FileVersion>
		<InformationalVersion>2.2.0</InformationalVersion>

		<!-- Package metadata -->
		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, .NET 9 and .NET 10, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>
		<PackageTags>Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;.NET9;.NET10;CloudNative</PackageTags>

		<!-- Release notes -->
		<PackageReleaseNotes>2.2.0: Multi-targeting release. The package now ships net8.0, net9.0 and net10.0 assets instead of net8.0 only. Depends on CoreSystem.Cache.Rehydration 2.1.3 and on CoreSystem.Redis 1.1.0, which carries StackExchange.Redis 2.13.17. The cross-repo dependencies are refreshed to CoreSystem.Http 1.2.0, CoreSystem.Memory 1.1.0, CoreSystem.Resilience 2.1.0 and CoreSystem.Serialization 1.3.0, which is what removes the NU1605 restore failure on net10.0 described in 2.1.3: earlier Resilience versions constrained Microsoft.Extensions.* to 8.0.x while OpenTelemetry asks for 10.0.0. Verified with real net8.0, net9.0 and net10.0 consumer projects: all three restore and resolve with no workaround. This build still declares CoreSystem.Cache.Rehydration 2.1.3 and CoreSystem.Cache 3.0.2 because those are the versions on the feed while it is prepared; the pins move to 2.2.0 and 3.1.0 once those versions are published. No public API changed, nothing is renamed and no code changed. AddCoreCacheRedis behaves exactly as in 2.1.3. The AddHealthChecks() prerequisite still applies: without it the redis_cache health check is never registered and rehydration cannot observe a recovery.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Framework references -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Internal visibility -->
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Dependencies -->
		<PackageReference Include="CoreSystem.Cache.Rehydration" />
		<PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

</Project>