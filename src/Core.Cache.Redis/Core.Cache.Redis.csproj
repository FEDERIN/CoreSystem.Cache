<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>3.0.0</Version>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<FileVersion>3.0.0.0</FileVersion>
		<InformationalVersion>3.0.0</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;CloudNative
		</PackageTags>
		<PackageReleaseNotes>3.0.0: Released to move the CoreSystem.Cache dependency to 3.0.0, which removes CacheOptions.MaxCacheableSize. That property was declared but never read by any code, so nothing in this package ever enforced it and no behaviour here changes. If you set MaxCacheableSize, delete the assignment; there is no replacement and no size limit is applied. No other public API is removed, renamed, or changed, and AddCoreCacheRedis and the rest of the provider behave exactly as in 2.1.1. The AddHealthChecks() prerequisite still applies: without it the redis_cache health check is never registered and rehydration cannot observe a recovery.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>	
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache.Rehydration\Core.Cache.Rehydration.csproj" />
	</ItemGroup>
</Project>
