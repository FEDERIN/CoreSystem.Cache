<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>2.1.3</Version>
		<AssemblyVersion>2.1.3</AssemblyVersion>
		<FileVersion>2.1.3.0</FileVersion>
		<InformationalVersion>2.1.3</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;CloudNative
		</PackageTags>
		<PackageReleaseNotes>2.1.3: Dependency refresh. Depends on CoreSystem.Cache.Rehydration 2.1.3 and on CoreSystem.Redis 1.0.4, which moves to StackExchange.Redis 2.13.17. No API changed, nothing is renamed, and no code changed here. Correction to the notes shipped with the previous versions, which claimed this package restores on .NET SDK 10 and later: that claim is false and was never verified. Tested against a real net10.0 consumer, restore fails with NU1605 through CoreSystem.Resilience, which constrains Microsoft.Extensions.* to 8.0.x while OpenTelemetry asks for 10.0.0, and the same is true of every version of this package up to and including 2.1.2. Projects on .NET 8 are unaffected. AddCoreCacheRedis and the rest of the provider behave exactly as in 2.1.2. The AddHealthChecks() prerequisite still applies: without it the redis_cache health check is never registered and rehydration cannot observe a recovery.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>	
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache.Rehydration\Core.Cache.Rehydration.csproj" />
	</ItemGroup>
</Project>
