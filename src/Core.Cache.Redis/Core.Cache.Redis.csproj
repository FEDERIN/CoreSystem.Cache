<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Package identity -->
		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>2.2.1</Version>

		<!-- Assembly versioning -->
		<AssemblyVersion>2.2.1.0</AssemblyVersion>
		<FileVersion>2.2.1.0</FileVersion>
		<InformationalVersion>2.2.1</InformationalVersion>

		<!-- Package metadata -->
		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, .NET 9 and .NET 10, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>
		<PackageTags>Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;.NET9;.NET10;CloudNative</PackageTags>

		<!-- Release notes -->
		<PackageReleaseNotes>2.2.1: Dependency refresh, patch release because no public API changed and no Redis code changed. This build declares CoreSystem.Cache.Rehydration 2.2.1 and CoreSystem.Cache 3.1.2, so the pin moves announced in 2.2.0 are now in effect. Through CoreSystem.Cache 3.1.2 it resolves CoreSystem.Memory 1.1.1, CoreSystem.Resilience 2.1.1 and CoreSystem.Serialization 1.3.1, which are the versions this package is built and tested against, so consumers stop pulling the older 1.1.0, 2.1.0 and 1.3.0 graph. The packed README was refreshed since 2.2.0. AddCoreCacheRedis behaves exactly as in 2.2.0, and the AddHealthChecks() prerequisite still applies: without it the redis_cache health check is never registered and rehydration cannot observe a recovery.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Framework references -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Internal visibility -->
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Dependencies -->
		<PackageReference Include="CoreSystem.Cache.Rehydration" />
		<PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

</Project>