<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>2.1.1</Version>
		<AssemblyVersion>2.1.1</AssemblyVersion>
		<FileVersion>2.1.1.0</FileVersion>
		<InformationalVersion>2.1.1</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;CloudNative
		</PackageTags>
		<PackageReleaseNotes>2.1.1: The README on this package page was a byte-identical copy of the core package README. It told Redis consumers to install CoreSystem.Cache and never mentioned AddCoreCacheRedis, the package's only public entry point. Rewritten for the Redis provider, and the AddHealthChecks() prerequisite is now documented: without it the redis_cache health check is never registered and rehydration cannot observe a recovery. The InstanceName examples no longer show a doubled colon, since the provider appends its own separator. Logging uses LoggerMessage delegates. XML documentation is now shipped. No public API was removed or renamed; the shipped XML documentation is the user-facing addition, which is why this is a minor release.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>	
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache.Rehydration\Core.Cache.Rehydration.csproj" />
	</ItemGroup>
</Project>
