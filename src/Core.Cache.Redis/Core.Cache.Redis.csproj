<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Cache.Redis</PackageId>
		<Version>3.0.1</Version>
		<AssemblyVersion>3.0.1</AssemblyVersion>
		<FileVersion>3.0.1.0</FileVersion>
		<InformationalVersion>3.0.1</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Redis external cache provider for CoreSystem.Cache on .NET 8, with tag-based invalidation, distributed locking, health checks, and optional resilience integration.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Cache</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Cache/Redis</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Distributed;Cache;Redis;Caching;CacheAside;DistributedLock;HealthChecks;Resilience;.NET8;CloudNative
		</PackageTags>
		<PackageReleaseNotes>3.0.1: Moves the dependency to CoreSystem.Cache 3.0.1, which depends on CoreSystem.Resilience 2.0.2. That combination is what restores this package on .NET SDK 10 and later: Resilience 2.0.1 pinned Microsoft.Extensions.* to 8.0.x while OpenTelemetry.Extensions.Hosting 1.19.0 asks for 10.0.0, and the resulting NU1605 broke restore before anything compiled. 3.0.0 cannot be fixed, because published versions are immutable. No public API changed, nothing was renamed, and no code changed here. AddCoreCacheRedis and the rest of the provider behave exactly as in 3.0.0. The AddHealthChecks() prerequisite still applies: without it the redis_cache health check is never registered and rehydration cannot observe a recovery.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
    	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>	
		<InternalsVisibleTo Include="Core.Cache.Redis.UnitTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Core.Cache.Rehydration\Core.Cache.Rehydration.csproj" />
	  <PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>
</Project>
