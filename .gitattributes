# Normalize line endings.
#
# Without this file the behaviour depends on each developer's core.autocrlf
# setting, so the same commit checks out differently on different machines.
# That already happened here: core.autocrlf=true normalizes on commit but
# leaves a file looking modified in the working tree after any tool rewrites
# it, which produced repeated false positives.
#
# Git stores LF for every tracked text file in this repository. These rules
# keep that true and restore CRLF on checkout for the Windows toolchain the
# project uses (Visual Studio, dotnet format). Adding this file caused no
# renormalization: all 208 tracked text files were already LF in the index.

* text=auto eol=crlf

# Shell scripts must stay LF. The .bat files below are the opposite case and
# are pinned to CRLF deliberately, because cmd.exe mishandles LF-only batch
# files with confusing errors that do not name the line endings as the cause.
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Project and solution files are read by MSBuild, which is tolerant either way,
# but pinning them keeps diffs predictable when generated.
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.sln     text eol=crlf
*.editorconfig text eol=crlf
*.globalconfig text eol=crlf

# Lock files are generated by restore and compared byte for byte against the
# resolved graph. Mixed endings here produce NU1004 with no useful message.
packages.lock.json text eol=crlf

# Documentation and CI definitions.
*.md   text eol=crlf
*.yml  text eol=crlf
*.yaml text eol=crlf

# Treat everything else that git can reasonably classify as text.
*.json text eol=crlf
*.txt  text eol=crlf
.gitignore  text eol=crlf
.gitattributes text eol=crlf

# No binary files are tracked in this repository, but declare the usual set so
# that adding an image or a fixture later cannot corrupt it on checkout.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.nupkg binary
*.snupkg binary
*.dll   binary
